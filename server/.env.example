# Copy to .env and adjust
NODE_ENV=development
PORT=5000
# Allowed origin(s) for CORS, comma separated (Next.js dev server)
CLIENT_URL=http://localhost:3000
# Folder produced by "npm run build" in /client (served in production)
STATIC_DIR=../client/out
# Rate limit: max requests per 15 minutes per IP on /api
RATE_LIMIT_MAX=100
